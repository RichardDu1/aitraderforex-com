---
// Footer.astro — 4-column footer with legal links
---

<footer class="bg-neutral text-muted mt-20 pt-16 pb-8 border-t border-border">
  <div class="container max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">
      <!-- Brand -->
      <div>
        <h3 class="text-text font-bold text-lg mb-3 flex items-center gap-2">
          <div class="w-6 h-6 rounded-lg bg-gradient-to-br from-primary to-primary-dark flex items-center justify-center">
            <span class="text-white text-xs font-black">AI</span>
          </div>
          <span>Trader</span><span class="text-primary">Forex</span>
        </h3>
        <p class="text-sm leading-relaxed">
          The only site dedicated to AI-powered forex trading signals, strategies, and tools — verified, tested, and ranked.
        </p>
      </div>

      <!-- Signal Reviews -->
      <div>
        <h4 class="text-text font-semibold mb-3">Reviews</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/signals/" class="hover:text-primary transition-colors">AI Signal Providers</a></li>
          <li><a href="/strategies/" class="hover:text-primary transition-colors">Trading Strategies</a></li>
          <li><a href="/propfirms/" class="hover:text-primary transition-colors">Prop Firms</a></li>
          <li><a href="/brokers/" class="hover:text-primary transition-colors">Brokers</a></li>
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h4 class="text-text font-semibold mb-3">Resources</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/comparison/" class="hover:text-primary transition-colors">Comparisons</a></li>
          <li><a href="/best/" class="hover:text-primary transition-colors">Best Of Rankings</a></li>
          <li><a href="/blog/" class="hover:text-primary transition-colors">Blog</a></li>
          <li><a href="/how-we-rate/" class="hover:text-primary transition-colors">How We Rate</a></li>
          <li><a href="/newsletter/" class="hover:text-primary transition-colors">Newsletter</a></li>
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h4 class="text-text font-semibold mb-3">Company</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/about/" class="hover:text-primary transition-colors">About Us</a></li>
          <li><a href="/contact/" class="hover:text-primary transition-colors">Contact</a></li>
          <li><a href="/privacy/" class="hover:text-primary transition-colors">Privacy Policy</a></li>
          <li><a href="/terms/" class="hover:text-primary transition-colors">Terms of Use</a></li>
          <li><a href="/sitemap/" class="hover:text-primary transition-colors">Sitemap</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-border pt-6 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs">
      <p>&copy; {new Date().getFullYear()} AI Trader Forex. All rights reserved.</p>
      <p>We may earn a commission from affiliate links at no extra cost to you. Forex trading carries high risk.</p>
    </div>
  </div>
</footer>