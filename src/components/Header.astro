---
// Header.astro — Sticky navigation with mobile hamburger menu
const navItems = [
  { label: 'Signals', href: '/signals/' },
  { label: 'Strategies', href: '/strategies/' },
  { label: 'Prop Firms', href: '/propfirms/' },
  { label: 'Brokers', href: '/brokers/' },
  { label: 'Comparisons', href: '/comparison/' },
  { label: 'Best Of', href: '/best/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'About', href: '/about/' },
];
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-border/50 dark:bg-surface/95">
  <div class="container max-w-7xl mx-auto flex items-center justify-between h-16 px-6">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 font-bold text-xl text-text no-underline shrink-0">
      <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-primary to-primary-dark flex items-center justify-center shadow-lg shadow-primary/20">
        <span class="text-white text-xs font-black">AI</span>
      </div>
      <span class="hidden sm:inline">Trader</span><span class="text-primary">Forex</span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-1" aria-label="Main navigation">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="text-sm font-medium text-muted hover:text-primary hover:bg-neutral/50 transition-colors px-3 py-2 rounded-lg"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Mobile Hamburger -->
    <button
      id="menu-toggle"
      class="md:hidden p-2 text-text"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Mobile Menu (hidden by default) -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-border bg-surface">
    <nav class="container max-w-7xl mx-auto flex flex-col py-4 gap-1 px-6" aria-label="Mobile navigation">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="text-sm font-medium text-muted hover:text-primary hover:bg-neutral/50 transition-colors px-3 py-3 rounded-lg"
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
  });
</script>