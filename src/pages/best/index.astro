---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const bestOfs = await getCollection('best-ofs');
---

<BaseLayout title="Best Of - Top Rankings" description="Curated best-of rankings for forex signals, trading strategies, prop firms, and brokers. Expert-ranked lists to help you choose the best.">
  <div class="container mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold mb-4">Best Of Rankings</h1>
    <p class="text-gray-400 mb-8 text-lg">Expert-curated rankings. We test, verify, and rank the best in each category.</p>

    <div class="grid md:grid-cols-2 gap-6">
      {bestOfs.map((best) => (
        <a href={`/best/${best.id}/`} class="block bg-gray-900 rounded-xl p-6 border border-gray-800 hover:border-[#533afd]/40 transition-colors">
          <h2 class="text-xl font-semibold mb-2">{best.data.title}</h2>
          <p class="text-gray-400 text-sm mb-4">{best.data.description}</p>
          <div class="flex items-center gap-2 text-sm text-gray-500">
            <span class="bg-gray-800 px-2 py-1 rounded">{best.data.rankings?.length || 0} items ranked</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>