---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const brokers = await getCollection('brokers');
  return brokers.map(broker => ({
    params: { slug: broker.id.split('/').pop() },
    props: { broker },
  }));
}

const { broker } = Astro.props;
const { Content } = await render(broker);

// Schema Markup
const brokerSchema = {
  "@context": "https://schema.org",
  "@type": "FinancialService",
  "name": broker.data.title,
  "description": broker.data.description
};
---

<BaseLayout
  title={`${broker.data.title} Due Diligence Report | AI Trader Forex`}
  description={broker.data.description}
  canonical={`https://aitraderforex.com/en/brokers/${broker.id.split('/').pop()}/`}
  schema={{ type: 'FinancialService', data: brokerSchema }}
>
  <article class="max-w-6xl mx-auto px-6 py-20 font-sans">
    <!-- Breadcrumbs -->
    <nav class="mb-8 text-sm text-muted font-bold">
      <a href="/brokers/" class="hover:text-primary transition-colors">Directory</a>
      <span class="mx-2">></span>
      <span class="text-primary">{broker.data.title}</span>
    </nav>

    <!-- Report Header -->
    <header class="mb-12 border-b-2 border-primary pb-8 flex flex-col md:flex-row justify-between items-start md:items-end gap-6">
      <div>
        <div class="inline-block bg-surface border border-border text-primary font-bold uppercase text-xs px-3 py-1 rounded mb-4">
          {broker.data.brokerType}
        </div>
        <h1 class="text-5xl md:text-6xl font-serif font-bold text-primary mb-4 leading-tight">{broker.data.title}</h1>
        <p class="text-xl text-muted max-w-2xl">{broker.data.description}</p>
      </div>
      
      <div class="bg-primary text-white p-6 rounded text-center w-full md:w-auto shadow-lg shrink-0">
        <span class="block text-xs uppercase tracking-widest text-accent font-bold mb-1">Trust Score</span>
        <span class={`text-6xl font-serif font-bold ${broker.data.trustScore >= 90 ? 'text-green-400' : 'text-yellow-400'}`}>
          {broker.data.trustScore}
        </span>
      </div>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <!-- Main Diligence Report -->
      <div class="lg:col-span-2">
        <div class="prose prose-lg max-w-none 
          prose-headings:font-serif prose-headings:font-bold prose-headings:text-primary
          prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-6 prose-h2:border-b prose-h2:border-border prose-h2:pb-4
          prose-p:text-slate-700 prose-p:leading-relaxed
          prose-a:text-accent prose-a:font-bold hover:prose-a:text-primary transition-colors
          prose-li:marker:text-accent">
          <Content />
        </div>
      </div>

      <!-- Quick Facts Sidebar -->
      <aside class="lg:col-span-1 space-y-6">
        <div class="bg-surface border border-border p-6 rounded shadow-none">
          <h3 class="font-bold text-sm uppercase tracking-widest text-muted mb-4 border-b border-border pb-2">Platform Specs</h3>
          
          <ul class="space-y-4">
            <li class="flex justify-between items-center">
              <span class="text-muted font-medium">Max Leverage</span>
              <span class="font-bold text-primary">{broker.data.maxLeverage}</span>
            </li>
            <li class="flex justify-between items-center">
              <span class="text-muted font-medium">Spreads</span>
              <span class="font-bold text-primary">{broker.data.spreads}</span>
            </li>
            <li class="flex justify-between items-center">
              <span class="text-muted font-medium">Allows EAs?</span>
              {broker.data.allowsEAs ? <span class="bg-green-100 text-green-800 text-xs font-bold px-2 py-1 rounded">Yes</span> : <span class="bg-red-100 text-red-800 text-xs font-bold px-2 py-1 rounded">No</span>}
            </li>
            <li class="flex justify-between items-center">
              <span class="text-muted font-medium">Payout Proof</span>
              {broker.data.payoutProof ? <span class="text-green-600 font-bold text-sm">Verified</span> : <span class="text-red-500 font-bold text-sm">Unverified</span>}
            </li>
          </ul>
        </div>

        <div class="bg-green-50 border border-green-200 p-6 rounded">
          <h3 class="font-bold text-sm uppercase tracking-widest text-green-800 mb-4">Pros</h3>
          <ul class="space-y-2">
            {broker.data.pros.map(pro => (
              <li class="flex items-start gap-2 text-sm text-green-900">
                <span class="text-green-600 font-black">+</span> {pro}
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-red-50 border border-red-200 p-6 rounded">
          <h3 class="font-bold text-sm uppercase tracking-widest text-red-800 mb-4">Cons (Red Flags)</h3>
          <ul class="space-y-2">
            {broker.data.cons.map(con => (
              <li class="flex items-start gap-2 text-sm text-red-900">
                <span class="text-red-600 font-black">-</span> {con}
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
