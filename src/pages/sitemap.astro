---
// HTML Sitemap — helps crawlers discover all pages
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const title = 'Sitemap — AI Trader Forex (2026)';
const description = 'Complete list of all pages on AI Trader Forex.';

const pages = [
  { label: 'Home', href: '/' },
  { label: 'AI Signal Providers', href: '/signals/' },
  { label: 'Trading Strategies', href: '/strategies/' },
  { label: 'Prop Firms', href: '/propfirms/' },
  { label: 'Brokers', href: '/brokers/' },
  { label: 'Comparisons', href: '/comparison/' },
  { label: 'Best Of Rankings', href: '/best/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'How We Rate', href: '/how-we-rate/' },
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
  { label: 'Newsletter', href: '/newsletter/' },
  { label: 'Privacy Policy', href: '/privacy/' },
  { label: 'Terms of Use', href: '/terms/' },
  { label: 'Finder', href: '/finder/' },
];
---

<BaseLayout title={title} description={description}>
  <Breadcrumb />
  <section class="container max-w-4xl mx-auto px-6 py-24">
    <h1 class="text-4xl font-black mb-8">Sitemap</h1>
    <ul class="space-y-3">
      {pages.map((p) => (
        <li>
          <a href={p.href} class="text-primary hover:text-primary-dark font-medium">{p.label}</a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>