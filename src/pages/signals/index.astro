---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const signals = await getCollection('signals');
const sortedSignals = signals.sort((a, b) => (b.data.score || 0) - (a.data.score || 0));
---

<BaseLayout title="Forex Trading Signals - Reviews & Rankings" description="Compare the best forex trading signal providers. Verified performance, transparency scores, and expert reviews of MetaTrader Signals, ZuluTrade, eToro and more.">
  <div class="container mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold mb-4">Forex Trading Signals</h1>
    <p class="text-gray-400 mb-8 text-lg">Verified reviews of top signal providers. Compare performance, transparency, and pricing.</p>

    <div class="grid gap-6">
      {
        sortedSignals.map((signal) => (
          <a href={`/signals/${signal.id}/`} class="block bg-gray-900 rounded-xl p-6 hover:bg-gray-800 transition-colors border border-gray-800 hover:border-[#533afd]/40">
            <div class="flex items-start gap-4">
              <div class="w-16 h-16 rounded-lg bg-[#533afd]/10 flex items-center justify-center flex-shrink-0">
                <span class="text-2xl font-bold text-[#533afd]">{signal.data.score}</span>
              </div>
              <div class="flex-1">
                <h2 class="text-xl font-semibold mb-1">{signal.data.title}</h2>
                <p class="text-gray-400 text-sm mb-2">{signal.data.description}</p>
                <div class="flex flex-wrap gap-3 text-xs text-gray-500">
                  <span class="bg-gray-800 px-2 py-1 rounded">Platform: {signal.data.platform}</span>
                  <span class="bg-gray-800 px-2 py-1 rounded">Price: {signal.data.price}</span>
                  <span class="bg-gray-800 px-2 py-1 rounded">Win Rate: {signal.data.winRate}</span>
                </div>
              </div>
              <div class="text-right flex-shrink-0">
                <div class="text-sm text-gray-400 mb-1">Transparency</div>
                <div class="w-20 h-2 bg-gray-800 rounded-full overflow-hidden">
                  <div class="h-full bg-[#533afd] rounded-full" style={`width: ${(signal.data.transparency || 0) * 10}%`}></div>
                </div>
                <div class="text-sm text-gray-400 mt-2 mb-1">Performance</div>
                <div class="w-20 h-2 bg-gray-800 rounded-full overflow-hidden">
                  <div class="h-full bg-green-500 rounded-full" style={`width: ${(signal.data.performance || 0) * 10}%`}></div>
                </div>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>