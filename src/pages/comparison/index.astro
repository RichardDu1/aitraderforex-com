---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const comparisons = await getCollection('comparisons');
---

<BaseLayout title="Signal & Strategy Comparisons" description="Head-to-head comparisons of forex signal providers, trading strategies, and platforms. Data-driven verdicts to help you choose.">
  <div class="container mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold mb-4">Comparisons</h1>
    <p class="text-gray-400 mb-8 text-lg">Side-by-side comparisons with expert verdicts. Make informed decisions.</p>

    <div class="grid gap-4">
      {comparisons.map((comp) => (
        <a href={`/comparison/${comp.id}/`} class="block bg-gray-900 rounded-xl p-6 border border-gray-800 hover:border-[#533afd]/40 transition-colors">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="font-semibold text-lg mb-1">{comp.data.title}</h2>
              <p class="text-gray-400 text-sm">{comp.data.description}</p>
            </div>
            {comp.data.winner && (
              <div class="text-right flex-shrink-0 ml-4">
                <div class="text-xs text-gray-500">Winner</div>
                <div class="text-[#533afd] font-semibold">{comp.data.winner}</div>
              </div>
            )}
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>