---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const comparisons = await getCollection('comparisons');
  return comparisons.map((comp) => ({
    params: { slug: comp.id },
    props: { comp },
  }));
}

const { comp } = Astro.props;
const { data } = comp;
---

<BaseLayout title={`${data.title} | Comparison`} description={data.description}>
  <div class="container mx-auto px-4 py-12">
    <div class="max-w-4xl mx-auto">
      <a href="/comparison/" class="text-[#533afd] hover:underline mb-6 inline-block">&larr; All Comparisons</a>
      <h1 class="text-3xl font-bold mb-4">{data.title}</h1>
      <p class="text-gray-400 mb-6 text-lg">{data.description}</p>

      <div class="grid md:grid-cols-2 gap-6 mb-8">
        {data.items.map((item: string) => (
          <div class="bg-gray-900 rounded-xl p-6 border border-gray-800">
            <h2 class="text-xl font-semibold mb-2">{item}</h2>
          </div>
        ))}
      </div>

      {data.winner && (
        <div class="bg-green-900/20 border border-green-500/30 rounded-xl p-6 mb-6">
          <h2 class="text-lg font-semibold text-green-400 mb-2">Winner: {data.winner}</h2>
          <p class="text-gray-300">{data.verdict}</p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>