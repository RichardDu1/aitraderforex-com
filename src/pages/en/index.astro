---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allBrokers = await getCollection('brokers');
// Sort by trust score descending
const topBrokers = allBrokers.sort((a, b) => b.data.trustScore - a.data.trustScore).slice(0, 3);

const pageTitle = 'Trusted AI Prop Firms & Brokers | AI Trader Forex';
const pageDescription = 'Independent, data-driven reviews of Prop Firms and Forex Brokers. Verify payout proofs, latency, and EA compatibility before you deposit.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical="https://aitraderforex.com/en/"
  schema={{ type: 'WebSite', data: { description: pageDescription } }}
>
  <!-- Financial Hero -->
  <header class="bg-primary text-white py-24 relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-20"></div>
    <div class="container max-w-5xl mx-auto px-6 text-center relative z-10">
      <h1 class="text-5xl md:text-7xl font-serif font-bold mb-6 text-white tracking-tight">
        Trade With <span class="text-accent italic">Confidence.</span>
      </h1>
      <p class="text-xl md:text-2xl text-slate-300 max-w-3xl mx-auto mb-10 leading-relaxed font-sans">
        We audit Prop Firms and Forex Brokers for hidden rules, EA restrictions, and verified payout proofs. Protect your capital.
      </p>
      <div class="flex justify-center gap-4">
        <a href="/en/brokers/" class="bg-accent text-primary font-bold px-8 py-4 uppercase tracking-widest text-sm hover:bg-white transition-colors border-2 border-accent">
          View Trusted Brokers
        </a>
      </div>
    </div>
  </header>

  <!-- Top Trusted Brokers Table -->
  <section class="container max-w-5xl mx-auto px-6 py-20">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-serif font-bold text-primary mb-4">Top 3 Trusted Platforms</h2>
      <p class="text-muted font-sans">Based on liquidity, payout history, and algorithm compatibility.</p>
    </div>

    <div class="bg-white rounded border border-border shadow-lg overflow-hidden font-sans">
      <div class="grid grid-cols-5 bg-surface border-b border-border text-xs uppercase tracking-widest font-bold text-muted p-4">
        <div class="col-span-2">Platform</div>
        <div class="text-center">Trust Score</div>
        <div class="text-center">Payout Proof</div>
        <div class="text-center">EA Friendly</div>
      </div>
      
      <div class="divide-y divide-border">
        {topBrokers.length > 0 ? topBrokers.map((broker, idx) => (
          <a href={`/en/brokers/${broker.id.split('/').pop()}`} class="grid grid-cols-5 p-6 items-center hover:bg-slate-50 transition-colors group">
            <div class="col-span-2 flex items-center gap-4">
              <div class="w-12 h-12 bg-primary text-accent font-bold flex items-center justify-center rounded">
                #{idx + 1}
              </div>
              <div>
                <h3 class="font-bold text-lg text-primary group-hover:text-accent transition-colors">{broker.data.title}</h3>
                <span class="text-xs text-muted uppercase tracking-wider">{broker.data.brokerType}</span>
              </div>
            </div>
            <div class="text-center">
              <span class={`font-bold text-lg ${broker.data.trustScore >= 90 ? 'text-green-600' : 'text-yellow-600'}`}>
                {broker.data.trustScore}/100
              </span>
            </div>
            <div class="text-center">
              {broker.data.payoutProof ? <span class="text-green-600 font-bold">✓ Verified</span> : <span class="text-red-500 font-bold">✗ No Data</span>}
            </div>
            <div class="text-center">
              {broker.data.allowsEAs ? <span class="text-green-600 font-bold">Yes</span> : <span class="text-red-500 font-bold">Restricted</span>}
            </div>
          </a>
        )) : (
          <div class="p-8 text-center text-muted font-bold border-2 border-dashed border-border m-4">
            Auditing platforms... please wait.
          </div>
        )}
      </div>
    </div>
    
    <div class="mt-8 text-center">
      <a href="/en/brokers/" class="text-primary hover:text-accent font-bold uppercase tracking-widest text-sm transition-colors border-b-2 border-primary hover:border-accent pb-1">
        View Full Directory
      </a>
    </div>
  </section>
</BaseLayout>
