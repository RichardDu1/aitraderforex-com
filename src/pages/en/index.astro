---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = 'The Developer Community for AI Trading';
const pageDescription = 'Open-source Python scripts, reinforcement learning models, and a community of quantitative traders.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical="https://aitraderforex.com/en/"
  schema={{ type: 'WebSite', data: { description: pageDescription } }}
>
  <!-- Community Hero -->
  <header class="relative px-6 pt-32 pb-24 overflow-hidden flex flex-col items-center text-center">
    <!-- Radiant Glow -->
    <div class="absolute top-0 w-full h-[600px] bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-indigo-900/40 via-surface to-surface -z-10"></div>
    
    <div class="px-4 py-1.5 rounded-full border border-indigo-500/30 bg-indigo-500/10 text-indigo-300 text-sm font-bold mb-8 flex items-center gap-2 backdrop-blur-md shadow-[0_0_15px_rgba(99,102,241,0.2)]">
      <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
      Over 4,500 Quants Online
    </div>

    <h1 class="text-5xl md:text-7xl font-extrabold mb-6 max-w-4xl leading-tight">
      Stop buying black-box EAs.<br/>
      <span class="gradient-text">Code your own edge.</span>
    </h1>

    <p class="text-xl text-muted max-w-2xl mb-10 leading-relaxed">
      The open-source community for algorithmic traders. Connect Python to MetaTrader 5, train Reinforcement Learning agents, and discuss market microstructure.
    </p>

    <div class="flex gap-4">
      <button class="bg-indigo-600 text-white font-bold px-8 py-4 rounded-xl hover:bg-indigo-500 transition-colors shadow-lg shadow-indigo-600/20">
        Join the Discord
      </button>
      <button class="bg-neutral border border-border text-white font-bold px-8 py-4 rounded-xl hover:bg-slate-700 transition-colors">
        Browse Scripts
      </button>
    </div>
  </header>

  <!-- Feed Layout (Discord/GitHub inspired) -->
  <section class="max-w-5xl mx-auto px-6 py-12">
    <div class="flex flex-col md:flex-row gap-8">
      
      <!-- Main Feed -->
      <div class="md:w-2/3">
        <h2 class="text-2xl font-bold mb-6 text-white border-b border-border pb-4">Latest Open Source Scripts</h2>
        
        <div class="space-y-4">
          <!-- Repo Item -->
          <div class="bg-neutral p-6 rounded-2xl border border-border hover:border-indigo-500/50 transition-colors cursor-pointer group">
            <div class="flex justify-between items-start mb-3">
              <h3 class="text-xl font-bold text-white group-hover:text-indigo-400 transition-colors flex items-center gap-2">
                <svg class="w-5 h-5 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path></svg>
                mt5-python-async-wrapper
              </h3>
              <span class="text-xs bg-indigo-500/20 text-indigo-300 px-2 py-1 rounded font-mono">v2.4.0</span>
            </div>
            <p class="text-muted text-sm mb-4 leading-relaxed">
              A high-performance, asynchronous wrapper for the MetaTrader 5 Python library. Handles socket disconnects and order execution flawlessly.
            </p>
            <div class="flex items-center gap-4 text-xs text-muted">
              <span class="flex items-center gap-1"><span class="w-3 h-3 rounded-full bg-blue-500"></span> Python</span>
              <span class="flex items-center gap-1">★ 342</span>
              <span>Updated 2 hours ago</span>
            </div>
          </div>

          <!-- Repo Item -->
          <div class="bg-neutral p-6 rounded-2xl border border-border hover:border-indigo-500/50 transition-colors cursor-pointer group">
            <div class="flex justify-between items-start mb-3">
              <h3 class="text-xl font-bold text-white group-hover:text-indigo-400 transition-colors flex items-center gap-2">
                <svg class="w-5 h-5 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path></svg>
                rl-grid-agent-ppo
              </h3>
              <span class="text-xs bg-purple-500/20 text-purple-300 px-2 py-1 rounded font-mono">Model</span>
            </div>
            <p class="text-muted text-sm mb-4 leading-relaxed">
              PPO-trained reinforcement learning model that dynamically adjusts grid trading spacing based on real-time ATR and volume profiling.
            </p>
            <div class="flex items-center gap-4 text-xs text-muted">
              <span class="flex items-center gap-1"><span class="w-3 h-3 rounded-full bg-yellow-500"></span> Jupyter</span>
              <span class="flex items-center gap-1">★ 189</span>
              <span>Updated 1 day ago</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="md:w-1/3">
        <div class="bg-neutral rounded-2xl p-6 border border-border">
          <h3 class="text-lg font-bold text-white mb-4">Trending Discussions</h3>
          <ul class="space-y-4">
            <li>
              <a href="#" class="text-sm font-semibold text-white hover:text-indigo-400 block mb-1">Are prop firms banning HFT bots?</a>
              <p class="text-xs text-muted">45 comments • Started by @quant_dev</p>
            </li>
            <li>
              <a href="#" class="text-sm font-semibold text-white hover:text-indigo-400 block mb-1">Latency test: NY4 vs LD4 Equinix</a>
              <p class="text-xs text-muted">12 comments • Started by @algo_trader</p>
            </li>
            <li>
              <a href="#" class="text-sm font-semibold text-white hover:text-indigo-400 block mb-1">DeepSeek Coder for MQL5 conversion</a>
              <p class="text-xs text-muted">89 comments • Started by @ai_max</p>
            </li>
          </ul>
        </div>
      </div>

    </div>
  </section>

</BaseLayout>
